# ============================================
# Voyago Holidays — Environment Configuration
# Copy this file to .env.local (for local dev)
# or add these variables in Vercel Project Settings
# ============================================

# 1. Supabase (Free Tier — https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# 2. Feature Flags
NEXT_PUBLIC_ENABLE_BOOKING_HEATMAP=true

# 3. Payment Gateway — Sandbox / Test Mode (Razorpay or PayU)
PAYMENT_GATEWAY_PROVIDER=razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_TEST_KEY
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_TEST_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# Optional PayU Sandbox Keys (if switching PAYMENT_GATEWAY_PROVIDER=payu)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# 4. Optional Analytics (GA4 / Mixpanel)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 5. Optional CRM / WhatsApp Webhook (Zoho CRM / HubSpot Starter)
CRM_WEBHOOK_URL=
